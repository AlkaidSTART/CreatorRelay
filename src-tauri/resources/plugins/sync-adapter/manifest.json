{
  "id": "creatorrelay.official.sync-adapter",
  "name": "CreatorRelay 同步与图文适配器",
  "description": "M6 同步验收适配器：读取四类作品与平台原始指标，图文可发布、视频不可发布。",
  "version": "1.0.0",
  "pluginType": "adapter",
  "adapterContractVersion": 1,
  "runtime": {
    "kind": "coreTestRunner",
    "profile": "healthy",
    "timeoutMs": 3000
  },
  "entry": "builtin://creatorrelay.official.sync-adapter",
  "permissions": [
    {
      "id": "account.credentials",
      "required": true,
      "reason": "使用账号作用域读取作品与指标"
    },
    {
      "id": "network",
      "required": false,
      "reason": "通过 Core 网络代理读取平台作品"
    },
    {
      "id": "platform.publish",
      "required": true,
      "reason": "执行已确认的图文与文章发布"
    }
  ],
  "capabilities": [
    {
      "kind": "video",
      "read": "supported",
      "publish": "unsupported",
      "note": "可读取视频作品，但测试平台不支持视频发布"
    },
    {
      "kind": "imageText",
      "read": "supported",
      "publish": "supported",
      "note": "图文发布可验证"
    },
    {
      "kind": "imageArticle",
      "read": "supported",
      "publish": "restricted",
      "note": "图文文章仍需人工审核"
    },
    {
      "kind": "article",
      "read": "supported",
      "publish": "supported",
      "note": "纯文章发布可验证"
    }
  ],
  "mcp": {
    "transport": "stdio",
    "command": "creatorrelay-adapter-runner",
    "args": []
  }
}
