{
  "id": "creatorrelay.official.fault-adapter",
  "name": "CreatorRelay 故障注入适配器",
  "description": "用于验证崩溃、超时、错误展示与重启恢复的官方测试适配器。",
  "version": "1.0.0",
  "pluginType": "adapter",
  "adapterContractVersion": 1,
  "runtime": {
    "kind": "coreTestRunner",
    "profile": "faulty",
    "timeoutMs": 1500
  },
  "entry": "builtin://creatorrelay.official.fault-adapter",
  "permissions": [
    {
      "id": "account.credentials",
      "required": true,
      "reason": "验证故障时账号代理不会泄露凭据"
    },
    {
      "id": "platform.publish",
      "required": true,
      "reason": "验证发布能力故障隔离"
    }
  ],
  "capabilities": [
    {
      "kind": "video",
      "read": "unsupported",
      "publish": "unsupported"
    },
    {
      "kind": "imageText",
      "read": "supported",
      "publish": "supported"
    },
    {
      "kind": "imageArticle",
      "read": "supported",
      "publish": "experimental"
    },
    {
      "kind": "article",
      "read": "supported",
      "publish": "supported"
    }
  ]
}
